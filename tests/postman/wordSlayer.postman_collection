          "listen": "test",
          "script": {
            "exec": [
              "// 1. Fånga upp JSON-svaret från C#\r",
              "const jsonData = pm.response.json();\r",
              "\r",
              "// TEST 1: Kollar att servern mår bra\r",
              "pm.test(\"Statuskoden ska vara 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// TEST 2: Kollar att ID:t finns och är rätt format\r",
              "pm.test(\"Ska innehålla ett giltigt sessionId (GUID)\", function () {\r",
              "    pm.expect(jsonData).to.have.property('sessionId');\r",
              "    pm.expect(jsonData.sessionId).to.be.a('string');\r",
              "    \r",
              "    // Använder ett mönster (Regex) för att garantera att det är en äkta GUID\r",
              "    pm.expect(jsonData.sessionId).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);\r",
              "});\r",
              "\r",
              "// TEST 3: Kollar att spelar-listan existerar och har 1 spelare\r",
              "pm.test(\"Det ska finnas exakt en spelare när spelet skapas\", function () {\r",
              "    pm.expect(jsonData).to.have.property('players');\r",
              "    pm.expect(jsonData.players).to.be.an('array');\r",
              "    pm.expect(jsonData.players.length).to.eql(1);\r",
              "});\r",
              "\r",
              "// TEST 4: Kollar startvärdena för Player 1\r",
              "pm.test(\"Spelaren ska ha rätt startvärden (100 HP, inga gissningar)\", function () {\r",
              "    const firstPlayer = jsonData.players[0]; // Plocka ut första spelaren\r",
              "    \r",
              "    pm.expect(firstPlayer.name).to.eql(\"Player 1\");\r",
              "    pm.expect(firstPlayer.health).to.eql(100);\r",
              "    pm.expect(firstPlayer.guesses).to.be.an('array').that.is.empty;\r",
              "});"
            ],
