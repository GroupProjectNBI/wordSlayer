              "pm.test(\"Statuskoden ska vara 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Spelar-listan ska nu innehålla 2 personer\", function () {\r",
              "    pm.expect(jsonData.players).to.be.an('array');\r",
              "    pm.expect(jsonData.players.length).to.eql(2);\r",
              "});\r",
              "\r",
              "pm.test(\"Spelare 2 ska ha lagts till korrekt\", function () {\r",
              "    const secondPlayer = jsonData.players[1]; \r",
              "    pm.expect(secondPlayer.name).to.eql(\"Spelare 2\");\r",
              "    pm.expect(secondPlayer.health).to.eql(100);\r",
              "});"
