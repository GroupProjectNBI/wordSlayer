    {
      "name": "Skada motståndaren genom att skicka in ett ord",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// 1. Kolla att anropet gick igenom\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Motståndarens hälsa har minskat korrekt\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    \r",
              "    // Vi hämtar \"Player 1\" från din miljövariabel 'player1'\r",
              "    const currentPlayerName = pm.environment.get(\"player1\").trim().toLowerCase(); \r",
              "    \r",
              "    // Hitta motståndaren genom att jämföra namnen i små bokstäver\r",
              "    const opponent = jsonData.players.find(p => p.name.trim().toLowerCase() !== currentPlayerName);\r",
              "    \r",
              "    // Logga ut för att se i konsolen (Ctrl+Alt+C) vem den hittade\r",
              "    console.log(\"Attackerare: \" + currentPlayerName);\r",
              "    console.log(\"Hittad motståndare: \" + opponent.name + \" med HP: \" + opponent.health);\r",
              "\r",
              "    // Verifiera att hälsan är under 100\r",
              "    pm.expect(opponent.health).to.be.below(100);\r",
              "    \r",
              "    // Bonus: Kolla att skadan stämmer exakt (valfritt)\r",
              "    // 85 är vad vi förväntar oss efter \"hello\" och \"structural\"\r",
              "    pm.expect(opponent.health).to.equal(85);\r",
              "});\r",
              "\r",
              "// 2. Kolla att motståndarens hälsa faktiskt har minskat\r",
              "pm.test(\"Opponent health was reduced\", function () {\r",
              "    const jsonData = pm.response.json();\r",
              "    \r",
              "    // Vi hämtar player1-namnet från din miljö\r",
              "    const currentPlayer = pm.environment.get(\"Player 1\"); \r",
              "    \r",
              "    // Hitta spelaren som INTE är den som nyss körde\r",
              "    const opponent = jsonData.players.find(p => p.name !== currentPlayer);\r",
              "    \r",
              "    // Vi förväntar oss att hälsan är mindre än 100\r",
              "    pm.expect(opponent.health).to.be.below(100);\r",
              "    console.log(\"Motståndarens hälsa är nu: \" + opponent.health);\r",
              "});\r",
              "\r",
              "// DONT FORGET TO MOVE THIS WHEN NEW REQUEST  IS COMMING\r",
              "pm.environment.set(\"sessionId\", null);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
