    {
      "name": "skicka in och verifiera ord",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// TEST 1: The Happy Path - Gick anropet igenom?\r",
              "pm.test(\"Statuskoden ska vara 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// TEST 2: Fick vi tillbaka ordet vi gissade på?\r",
              "pm.test(\"Ska returnera ordet som vi spelade\", function () {\r",
              "    // Eftersom din C#-kod just nu returnerar Results.Ok(request.wordGuess) \r",
              "    // som en ren sträng (inte ett JSON-objekt), kollar vi svaret så här:\r",
              "    const responseBody = pm.response.text();\r",
              "    pm.expect(responseBody).to.include(\"hello\");\r",
              "});\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
